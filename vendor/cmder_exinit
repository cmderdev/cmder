# Source from /etc/profile.d/zz-cmder_exinit.sh (Bash) or .zsh (Zsh).
# Set CMDER_ROOT to enable Cmder settings when launching outside Cmder.
# CMDER_ROOT="${USERPROFILE}/cmder"

if [ -z "${CMDER_ROOT:-}" ]; then
  CMDER_ROOT="${cmder_root:-}"
fi

if [ -z "$CMDER_ROOT" ]; then
  case "${ConEmuDir:-}" in
    [A-Za-z]:*|*\\*) CMDER_ROOT=$(cd "$(cygpath -u "$ConEmuDir")/../.." && pwd) || return 1 ;;
  esac
fi

[ -n "$CMDER_ROOT" ] || return 0
case "$CMDER_ROOT" in
  [A-Za-z]:*|*\\*) CMDER_ROOT=$(cygpath -u "$CMDER_ROOT") || return 1 ;;
esac

if [ ! -r "$CMDER_ROOT/vendor/lib/lib_console.sh" ]; then
  printf '[cmder] Cannot read console library: %s\n' "$CMDER_ROOT/vendor/lib/lib_console.sh" >&2
  return 1
fi
. "$CMDER_ROOT/vendor/lib/lib_console.sh" || return 1

if [ ! -r "$CMDER_ROOT/vendor/cmder.sh" ]; then
  printf '[cmder] Cannot read startup script: %s\n' "$CMDER_ROOT/vendor/cmder.sh" >&2
  return 1
fi
debug_output cmder_exinit "Sourcing startup script: $CMDER_ROOT/vendor/cmder.sh"
. "$CMDER_ROOT/vendor/cmder.sh"
